# API Gateway Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Service URLs
USER_SERVICE_URL=http://localhost:3001
TEMPLATE_SERVICE_URL=http://localhost:3002
ORCHESTRATOR_SERVICE_URL=http://localhost:8080
EMAIL_SERVICE_URL=http://localhost:8000
PUSH_SERVICE_URL=http://localhost:8081

# Redis Configuration
REDIS_URL=redis://:redis-password@localhost:6379/0

# Logging
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
