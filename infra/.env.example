# Database Configuration
DB_USER=postgres
DB_PASSWORD=your-secure-password-here
DB_NAME=postgres

# PgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=your-secure-password-here

# Redis Configuration
REDIS_PASSWORD=your-secure-password-here

# Shared Secrets
# JWT_SECRET must be identical across api-gateway, user-service and template-service.
JWT_SECRET=your-jwt-signing-secret-here
# INTERNAL_SERVICE_TOKEN authenticates service-to-service calls (orchestrator -> user/template).
INTERNAL_SERVICE_TOKEN=your-internal-service-token-here

# RabbitMQ Configuration
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Environment
ENVIRONMENT=development
