# Orchestrator Service Configuration
ORCHESTRATOR_SERVER.PORT=8080
ORCHESTRATOR_SERVER.READ_TIMEOUT=30
ORCHESTRATOR_SERVER.WRITE_TIMEOUT=30
ORCHESTRATOR_SERVER.IDLE_TIMEOUT=120
ORCHESTRATOR_SERVER.CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Database Configuration
ORCHESTRATOR_DATABASE.HOST=localhost
ORCHESTRATOR_DATABASE.PORT=5432
ORCHESTRATOR_DATABASE.USER=postgres
ORCHESTRATOR_DATABASE.PASSWORD=your-secure-password-here
ORCHESTRATOR_DATABASE.NAME=notification_db
ORCHESTRATOR_DATABASE.SSL_MODE=disable
ORCHESTRATOR_DATABASE.MAX_OPEN_CONNS=25
ORCHESTRATOR_DATABASE.MAX_IDLE_CONNS=5
ORCHESTRATOR_DATABASE.CONN_MAX_LIFETIME=5m
ORCHESTRATOR_DATABASE.CONN_MAX_IDLE_TIME=1m

# Redis Configuration
ORCHESTRATOR_REDIS.ADDRESS=localhost:6379
ORCHESTRATOR_REDIS.PASSWORD=your-secure-password-here
ORCHESTRATOR_REDIS.DB=1

# RabbitMQ Configuration
ORCHESTRATOR_RABBITMQ.URL=amqp://guest:guest@localhost:5672/
ORCHESTRATOR_RABBITMQ.EXCHANGE_NAME=notifications
ORCHESTRATOR_RABBITMQ.EXCHANGE_TYPE=topic
ORCHESTRATOR_RABBITMQ.QUEUE_NAME=orchestrator_events
ORCHESTRATOR_RABBITMQ.ROUTING_KEY=notification.*
ORCHESTRATOR_RABBITMQ.PREFETCH_COUNT=10

# Environment
ENVIRONMENT=development
LOG_LEVEL=debug

# External Services
ORCHESTRATOR_EXTERNAL.USER_SERVICE_ADDRESS=http://user-service:3007
ORCHESTRATOR_EXTERNAL.TEMPLATE_SERVICE_ADDRESS=http://template-service:3003
ORCHESTRATOR_EXTERNAL.INTERNAL_TOKEN=your-internal-service-token-here

# Legacy/unused - superseded by ORCHESTRATOR_EXTERNAL.* above
USER_SERVICE_URL=http://localhost:3001
TEMPLATE_SERVICE_URL=http://localhost:3002
EMAIL_SERVICE_URL=http://localhost:8000
PUSH_SERVICE_URL=http://localhost:8081

# Request Configuration
REQUEST_TIMEOUT=30s
RETRY_ATTEMPTS=3
RETRY_BACKOFF=2s
