# User Service Configuration
PORT=3001
NODE_ENV=development

# Database (Prisma)
DATABASE_URL=postgresql://postgres:password@localhost:5432/user_service

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Shared secret for service-to-service calls (must match the orchestrator's)

# Redis Configuration (for caching)
REDIS_URL=redis://:redis-password@localhost:6379/2

# Logging
LOG_LEVEL=debug

# User Service Configuration
USER_CACHE_TTL=3600
PREFERENCES_CACHE_TTL=1800

# External Services
ORCHESTRATOR_SERVICE_URL=http://localhost:8080
API_GATEWAY_URL=http://localhost:3000

# CORS
CORS_ORIGIN=http://localhost:3000

# API Configuration
API_VERSION=v1
API_PREFIX=/api

# Security
PASSWORD_MIN_LENGTH=8
PASSWORD_HASH_ROUNDS=10
