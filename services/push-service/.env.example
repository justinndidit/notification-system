# Push Service Configuration
SERVICE_NAME=push-service
PORT=8081
ENVIRONMENT=development
LOG_LEVEL=info

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE=push_notifications
RABBITMQ_EXCHANGE=notifications
RABBITMQ_ROUTING_KEY=push.*
RABBITMQ_PREFETCH=10
RABBITMQ_RECONNECT=true

# FCM (Firebase Cloud Messaging) Configuration
FCM_ENABLED=true
FCM_PROJECT_ID=your-firebase-project-id
FCM_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json
FCM_SERVICE_ACCOUNT_JSON=
FCM_MAX_RETRIES=3

# APNS (Apple Push Notification Service) Configuration
APNS_ENABLED=false
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apns-team-id
APNS_BUNDLE_ID=com.example.app
APNS_KEY_PATH=./config/apns-key.p8
APNS_PRODUCTION=false

# Redis Configuration
REDIS_URL=localhost:6379
REDIS_PASSWORD=redis-password
REDIS_DB=3

# Service Configuration
REQUEST_TIMEOUT=30s
RETRY_ATTEMPTS=3
RETRY_BACKOFF=2s
MAX_CONCURRENT_SENDS=100
