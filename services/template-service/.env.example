# Template Service Configuration
PORT=3002
NODE_ENV=development

# Database (Prisma)
DATABASE_URL=postgresql://postgres:password@localhost:5432/template_service

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Shared secret for service-to-service calls (must match the orchestrator's)
INTERNAL_SERVICE_TOKEN=your-internal-service-token-here

# Redis Configuration
REDIS_URL=redis://:redis-password@localhost:6379/1

# Logging
LOG_LEVEL=debug

# Template Configuration
TEMPLATE_CACHE_TTL=3600
MAX_TEMPLATE_SIZE=10000
ENABLE_PREVIEW=true

# External Services
ORCHESTRATOR_SERVICE_URL=http://localhost:8080

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# API Configuration
API_VERSION=v1
API_PREFIX=/api
